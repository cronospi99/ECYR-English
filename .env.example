# Supabase — accounts, progress sync, AI Coach.
# These are the PUBLIC (publishable/anon) values; row-level security protects the data.
# The integrated IELTS Simulator uses the same client, so one sign-in covers everything.
# Find both in Supabase → Project Settings → API Keys (publishable key) and the
# project URL https://<project-ref>.supabase.co (the ref is in the dashboard URL).
VITE_SUPABASE_URL=https://eecqfbxisquimaowhbmg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_t3ojNz8SocY9YfllocR-6Q_tjTtmt8q

# Natural voices (/api/tts, Vercel function). Server-side only: set it in Vercel →
# Settings → Environment Variables (no VITE_ prefix, so it never reaches the browser).
# Any long random string, e.g. `openssl rand -hex 32`. It is NOT a Supabase key.
TTS_SIGNING_SECRET=
