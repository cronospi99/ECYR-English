    "point": "Adverbial clauses of time: when, after, before",
    "title": "Time clause: first or last",
    "note_es": "La cláusula de tiempo puede ir al principio (con coma) o al final (sin coma). Para el futuro usa presente simple: after I finish.",
    "tone": "yellow",
    "from": { "label_es": "Cláusula primero", "tokens": [ { "t": "After I finish,", "role": "extra", "id": "t" }, { "t": "I'll call you.", "role": "verb", "id": "m" } ] },
    "to": { "label_es": "Cláusula al final", "tokens": [ { "t": "I'll call you", "role": "verb", "id": "m" }, { "t": "after I finish.", "role": "extra", "id": "t" } ] }
  },
  "A2-10-0": {
    "kind": "compare",
    "point": "Gerunds and short responses",
    "title": "Agree or disagree with short responses",
    "note_es": "Tras like, love, hate + -ing, responde con So do I o Neither do I para coincidir, y con I don't o I do para contradecir.",
    "columns": [
      { "head": "agree", "head_es": "coincidir", "use_es": "So / Neither / Me too.", "tone": "green", "items": [ { "t": "I love cooking. — So do I." }, { "t": "I hate waiting. — Me too." }, { "t": "I don't like fish. — Neither do I." } ] },
      { "head": "disagree", "head_es": "contradecir", "use_es": "Opuesto con do / don't.", "tone": "red", "items": [ { "t": "I love cooking. — I don't." }, { "t": "I hate waiting. — Oh, I don't mind it." }, { "t": "I don't like fish. — I do." } ] }
    ]
  },
  "A2-10-1": {
    "kind": "compare",
    "point": "Clauses with “because”",
    "title": "Because, because of and so",
    "note_es": "Because va con una oración (sujeto + verbo). Because of va con un nombre. So da el resultado.",
    "columns": [
      { "head": "because", "head_es": "+ oración", "use_es": "Razón con sujeto y verbo.", "tone": "blue", "items": [ { "t": "I stayed home because I felt ill.", "ok": true }, { "t": "I stayed home because the rain.", "ok": false } ] },
      { "head": "because of", "head_es": "+ nombre", "use_es": "Razón con un nombre.", "tone": "orange", "items": [ { "t": "I stayed home because of the rain.", "ok": true }, { "t": "I stayed home because of I felt ill.", "ok": false } ] },
      { "head": "so", "head_es": "resultado", "use_es": "Va después de la causa.", "tone": "green", "items": [ { "t": "It was raining, so we stayed in.", "ok": true }, { "t": "So it was raining, we stayed in.", "ok": false } ] }
    ]
  },
  "A2-13-0": {
    "kind": "compare",
    "point": "Participles as adjectives: present and past",
    "title": "Boring vs bored",
    "note_es": "-ing describe lo que causa la emoción (la película). -ed describe a quien la siente (yo).",
    "columns": [
      { "head": "-ing", "head_es": "la causa", "use_es": "Cosas o situaciones.", "tone": "orange", "items": [ { "t": "The film was boring.", "ok": true }, { "t": "It was a tiring journey.", "ok": true }, { "t": "The film was bored.", "ok": false } ] },
      { "head": "-ed", "head_es": "quien lo siente", "use_es": "Personas que sienten.", "tone": "blue", "items": [ { "t": "I was bored.", "ok": true }, { "t": "She was tired after the trip.", "ok": true }, { "t": "We watched a bored film.", "ok": false } ] }
    ]
  },
  "A2-14-0": {
    "kind": "scale",
    "point": "Modals and adverbs for degrees of certainty",
    "title": "How sure are you?",
    "note_es": "Los modales y adverbios muestran cuánta certeza tienes: can't (seguro que no), might (posible), probably, must (casi seguro).",
    "tone": "purple",
