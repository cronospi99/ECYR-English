  "A2-3-0": {
    "kind": "compare",
    "point": "Evaluations and comparisons with adjectives and nouns",
    "title": "Too, enough and as...as",
    "note_es": "Too = más de lo necesario (algo malo). Enough = suficiente, va después del adjetivo. As...as compara dos cosas iguales.",
    "columns": [
      { "head": "too", "head_es": "demasiado", "use_es": "Too + adjetivo; too much/many + nombre.", "tone": "red", "items": [ { "t": "The flat is too small.", "ok": true }, { "t": "There is too much noise.", "ok": true }, { "t": "The flat is very too small.", "ok": false } ] },
      { "head": "enough", "head_es": "suficiente", "use_es": "Adjetivo + enough; enough + nombre.", "tone": "green", "items": [ { "t": "It isn't big enough.", "ok": true }, { "t": "We have enough chairs.", "ok": true }, { "t": "It isn't enough big.", "ok": false } ] },
      { "head": "as ... as", "head_es": "igual de", "use_es": "Compara dos cosas iguales.", "tone": "blue", "items": [ { "t": "It's as expensive as my old flat.", "ok": true }, { "t": "It's not as clean as mine.", "ok": true }, { "t": "It's as expensive than mine.", "ok": false } ] }
    ]
  },
