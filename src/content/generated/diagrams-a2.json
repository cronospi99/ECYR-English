  "A2-7-0": {
    "kind": "compare",
    "point": "Infinitives and gerunds for uses and purposes",
    "title": "To + verb vs for + -ing",
    "note_es": "Para explicar el objetivo de una acción usa to + verbo. Para decir la función de una cosa usa for + -ing.",
