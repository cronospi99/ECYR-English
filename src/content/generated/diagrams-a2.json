      { "head": "could have", "head_es": "pude (y no)", "use_es": "Posibilidad que no ocurrió.", "tone": "green", "items": [ { "t": "We could have won.", "ok": true }, { "t": "She could have gone.", "ok": true }, { "t": "We could have win.", "ok": false } ] }
    ]
  },
