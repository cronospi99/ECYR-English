      { "head": "to + verb", "head_es": "objetivo de una acción", "use_es": "Por qué haces algo.", "tone": "blue", "items": [ { "t": "I called to confirm the time.", "ok": true }, { "t": "I left early so as not to miss it.", "ok": true }, { "t": "I called for confirm the time.", "ok": false } ] },
