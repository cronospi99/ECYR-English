    "from_es": "0 % de las veces",
    "to_es": "100 % de las veces",
    "marks": [
      { "t": "never", "at": 3, "tone": "red", "label_es": "nunca", "ex": "I never eat meat." },
      { "t": "hardly ever", "at": 20, "tone": "orange", "label_es": "casi nunca", "ex": "She hardly ever walks to school." },
      { "t": "sometimes", "at": 41, "tone": "yellow", "label_es": "a veces", "ex": "We sometimes eat out." },
      { "t": "usually", "at": 62, "tone": "mint", "label_es": "normalmente", "ex": "We usually have lunch at one." },
      { "t": "almost always", "at": 80, "tone": "teal", "label_es": "casi siempre", "ex": "He is almost always on time." },
      { "t": "always", "at": 97, "tone": "green", "label_es": "siempre", "ex": "I always brush my teeth." }
    ]
  },
