  "A1-6-0": {
    "kind": "scale",
    "point": "Adverbs of frequency",
    "title": "Adverbs of frequency",
    "note_es": "Estos adverbios dicen cuántas veces ocurre algo. Van antes del verbo principal y después de am/is/are.",
