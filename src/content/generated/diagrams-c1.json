      "kind": "transform", "point": "Subject-verb inversion in conditionals", "tone": "purple",
      "title": "Inversion with had",
      "from": { "label_es": "Con if", "tokens": [ { "t": "If", "role": "link", "drop": true }, { "t": "we", "role": "subject", "id": "s" }, { "t": "had", "role": "aux", "id": "a" }, { "t": "known,", "role": "verb", "id": "v" }, { "t": "we’d have come", "role": "other" } ] },
      "to": { "label_es": "Invertida", "tokens": [ { "t": "Had", "role": "aux", "id": "a" }, { "t": "we", "role": "subject", "id": "s" }, { "t": "known,", "role": "verb", "id": "v" }, { "t": "we’d have come", "role": "other" } ] },
      "note_es": "Had + sujeto + participio sustituye a if + past perfect para condiciones pasadas irreales."
    },
    {
      "kind": "transform", "point": "Subject-verb inversion in conditionals", "tone": "purple",
