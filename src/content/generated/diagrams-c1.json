      "to": { "label_es": "Invertida", "tokens": [ { "t": "Were", "role": "verb", "id": "v" }, { "t": "I", "role": "subject", "id": "s" }, { "t": "you,", "role": "complement", "id": "c" }, { "t": "I’d apologise", "role": "other" } ] },
      "note_es": "Se quita if y el verbo pasa antes del sujeto. Es más formal."
    },
